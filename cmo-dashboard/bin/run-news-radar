#!/usr/bin/env bash
# Keep exactly one news radar ticking, and say so.
#
# The radar sweeps the EV beat once a day at 07:00 IST. There is no cron here —
# no crontab binary, no /etc/cron.d — and the watchdog that used to be the
# scheduler was decommissioned on 2026-08-04 along with the rest of v1
# orchestration. A tmux session is the durable runtime this box actually has,
# and it is the pattern the content worker has survived on since August.
#
# This is deliberately NOT a revival of that orchestration. The radar writes to
# state/console.db only; `propose()` mints no board card, so nothing here can
# touch tasks.md and nothing here can recreate the two-stacks-one-board failure.
#
# The clock lives in the Python, not here: `--due` checks the IST hour, takes a
# flock, and stamps state/news-radar-last-run, so a tick outside the window is a
# cheap no-op. That is why the loop polls every half hour rather than sleeping
# until exactly 07:00 — a container restart at 06:59 must not skip the day.
#
# Idempotent on purpose: safe to call on every container start, and by hand.
set -euo pipefail

PROFILE_DIR="${CMO_DASHBOARD_PROFILE_DIR:-/opt/data/profiles/itarang_cmo}"
SESSION="cmo-news-radar"
TMUX_BIN="$PROFILE_DIR/bin/tmux"
PYTHON="${CMO_WORKER_PYTHON:-/opt/hermes/.venv/bin/python}"
LOG="$PROFILE_DIR/logs/news-radar.log"
INTERVAL="${CMO_RADAR_POLL_SECONDS:-1800}"

# The vendored tmux carries its own libevent. Without this it fails to start with
# a shared-library error, which reads exactly like a missing binary.
export LD_LIBRARY_PATH="/opt/data/.local/tmux-pkg/unpacked/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# $TMUX is tmux's own protocol variable: inside a pane it is already exported and
# names the server socket. Assigning to a variable of that name once replaced the
# tmux binary at $PROFILE_DIR/bin/tmux with a socket. Never name one that, and
# drop any inherited one so a run from inside a pane cannot leak its parent's.
unset TMUX TMUX_PANE

fail() { printf 'news radar: %s\n' "$1" >&2; exit 1; }

[[ -x "$TMUX_BIN" && ! -S "$TMUX_BIN" ]] || fail "$TMUX_BIN is not an executable tmux"
[[ -x "$PYTHON" ]] || fail "missing interpreter: $PYTHON"
[[ -f "$PROFILE_DIR/cmo_runtime/news_radar.py" ]] || fail "the radar is not deployed to $PROFILE_DIR/cmo_runtime"
mkdir -p "$(dirname "$LOG")"

# Unlike the content worker, this loop has no long-lived process of its own: for
# all but a few seconds a day it is a `sleep`. So liveness is the pane, not a
# pgrep — and a live pane is not enough either, because a pane can be sitting on
# a shell that already exited. Ask tmux whether the pane is dead.
pane_alive() {
  "$TMUX_BIN" has-session -t "$SESSION" 2>/dev/null || return 1
  [[ "$("$TMUX_BIN" list-panes -t "$SESSION" -F '#{pane_dead}' 2>/dev/null | head -n 1)" == "0" ]]
}

if pane_alive; then
  printf 'news radar: already running (session %s)\n' "$SESSION"
  exit 0
fi

"$TMUX_BIN" kill-session -t "$SESSION" 2>/dev/null || true

# `-u` so the log is written as it happens rather than when the buffer fills. The
# timestamp before each tick is what makes "it has been quiet for a day" legible
# as ticking-and-not-due rather than as stopped.
"$TMUX_BIN" new-session -d -s "$SESSION" -x 160 -y 48 \
  "cd '$PROFILE_DIR' && PYTHONPATH='$PROFILE_DIR' exec bash -c 'while true; do printf \"%s tick\\n\" \"\$(date -Is)\"; \"$PYTHON\" -u -m cmo_runtime.news_radar --profile \"$PROFILE_DIR\" --due || true; sleep $INTERVAL; done' >>'$LOG' 2>&1"

for _ in $(seq 1 20); do
  if pane_alive; then
    printf 'news radar: started (session %s, log %s, poll %ss)\n' "$SESSION" "$LOG" "$INTERVAL"
    exit 0
  fi
  sleep 0.5
done

tail -20 "$LOG" >&2 || true
fail "the radar did not come up; see $LOG"
