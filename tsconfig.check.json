{
  // Narrow typecheck for changed files, per CLAUDE.md section 3: never a whole
  // project check, and never a build. The bare `tsc <file>` command in that
  // section cannot resolve the "@/*" paths from tsconfig.json (there is no way
  // to pass `paths` on the command line), so it reports only TS2307 and hides
  // every real error. Extending the root config keeps path resolution.
  //
  // Usage: list the files you touched in "files", then
  //   npx tsc --noEmit -p tsconfig.check.json
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false, "noEmit": true },
  "files": [
    "scripts/build-india-map.ts",
    "scripts/build-pincode-areas.ts",
    "src/lib/geo/rings.ts",
    "src/lib/dealers/crm.ts",
    "src/lib/dealers/locations.ts",
    "src/lib/dealers/nearest.ts",
    "src/lib/dealers/locate.test.ts",
    "src/lib/dealers/nearest.test.ts",
    "src/app/api/dealers/nearest/route.ts",
    "src/app/(marketing)/for-dealers/page.tsx",
    "src/components/partners/dealer-map/IndiaMap.tsx",
    "src/components/partners/dealer-map/useMapViewport.ts",
    "src/components/partners/dealer-map/DealerMapCard.tsx",
    "src/components/partners/dealer-map/DealerNetworkMap.tsx",
    "src/components/partners/dealer-map/DealerSearch.tsx",
    "src/components/partners/dealer-map/NearestDealerList.tsx"
  ]
}
