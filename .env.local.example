# ---- ElevenLabs AI caller (iTarang Admin → Partner Network Growth → AI caller) ----
# Server-side API key. Never committed. Get it from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ---- OpenAI intent scoring (runs after each completed AI call) ----
# Server-side API key. Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override the model used for scoring. Default: gpt-4o-mini (broadly available).
# Swap to gpt-4.1-mini, gpt-5-mini, gpt-5.1-mini etc. once your account has access.
OPENAI_INTENT_MODEL=gpt-4o-mini

# ---- SMS OTP via 2Factor.in (calculator gate on /how-it-works & /products) ----
# Server-side API key from https://2factor.in dashboard. AUTOGEN mode: 2Factor
# generates + sends + verifies the code; we never store it.
TWOFACTOR_API_KEY=
# Optional: named DLT-approved OTP template for branded SMS wording.
# TWOFACTOR_TEMPLATE_NAME=
# Optional: set to 1 to force mock mode (dev code 123456, no SMS, no credits).
# Also implied when TWOFACTOR_API_KEY is unset outside production.
# TWOFACTOR_MOCK=

# ---- WhatsApp scheme-results delivery via Meta Cloud API (post-calculation) ----
# NOTE: OTP no longer uses WhatsApp (see 2Factor above). These are ONLY for
# pushing the calculated schemes + onboarding prompt to the customer's WhatsApp
# after a verified calc. Optional — unset to skip WhatsApp delivery entirely.
# Use a PERMANENT System-User token (Meta setup tokens expire in ~24h).
WHATSAPP_PROVIDER=meta
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Template to deliver the scheme RESULTS to the customer's WhatsApp after a
# verified calc. Body params: [customerName, modelName, schemesOneLine].
# Unset = free-form text (works inside the customer's 24h session).
# CALC_RESULTS_WA_TEMPLATE=itarang_calc_results
# CALC_RESULTS_WA_TEMPLATE_LANG=en
# Optional: Graph API version override (default v21.0).
# META_WA_GRAPH_VERSION=v21.0

# ---- Loan Calculator (/how-it-works, /products) — REQUIRED ----
# Shared AWS RDS database-2 connection string (calc_* tables, owned by the CRM repo).
DATABASE_URL=
# HMAC secret for the calculator verified-cookie (any long random string).
CALC_GATE_SECRET=

# ---- Existing integrations (only needed if you touch the chatbot / knowledge base) ----
GROQ_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIRECRAWL_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=


# Google Analytics 4 — the browser tag. Unset means no tag is rendered at all,
# which is what a local checkout and a preview deploy should do.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Tag Manager container. Optional: the production container id is the
# built-in default, and the tag renders only on a production, non-preview
# deploy regardless. Set this only to point the site at a different container.
NEXT_PUBLIC_GTM_ID=
