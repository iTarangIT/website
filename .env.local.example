# ---- ElevenLabs AI caller (iTarang Admin → Partner Network Growth → AI caller) ----
# Server-side API key. Never committed. Get it from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ---- OpenAI intent scoring (runs after each completed AI call) ----
# Server-side API key. Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override the model used for scoring. Default: gpt-4o-mini (broadly available).
# Swap to gpt-4.1-mini, gpt-5-mini, gpt-5.1-mini etc. once your account has access.
OPENAI_INTENT_MODEL=gpt-4o-mini

# ---- WhatsApp OTP via Meta Cloud API (calculator gate on /how-it-works & /products) ----
# Same Meta integration the CRM uses. Copy these two from the CRM's .env.local.
# Use a PERMANENT System-User token (Meta setup tokens expire in ~24h).
WHATSAPP_PROVIDER=meta
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Optional but REQUIRED to deliver to numbers that haven't messaged us in 24h
# (i.e. real users): a pre-approved AUTHENTICATION template, one body param = the code.
# CALC_OTP_WA_TEMPLATE=itarang_otp
# CALC_OTP_WA_TEMPLATE_LANG=en
# Optional: template to deliver the scheme RESULTS to the customer's WhatsApp
# after a verified calc. Body params: [customerName, modelName, schemesOneLine].
# Unset = free-form text (works inside the customer's 24h session).
# CALC_RESULTS_WA_TEMPLATE=itarang_calc_results
# CALC_RESULTS_WA_TEMPLATE_LANG=en
# Optional: Graph API version override (default v21.0).
# META_WA_GRAPH_VERSION=v21.0
# Leave META_WA_* unset in local dev to use the dev OTP 123456 (no WhatsApp sent).

# ---- Loan Calculator (/how-it-works, /products) — REQUIRED ----
# Shared AWS RDS database-2 connection string (calc_* tables, owned by the CRM repo).
DATABASE_URL=
# HMAC secret for the calculator verified-cookie (any long random string).
CALC_GATE_SECRET=

# ---- Existing integrations (only needed if you touch the chatbot / knowledge base) ----
GROQ_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIRECRAWL_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

